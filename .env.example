# === Database (Neon PostgreSQL) ===
# Use the connection string WITHOUT the pooler (direct host) for Prisma transactions.
# Create a separate production database on Neon for deployment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/db?sslmode=require"

# === Database keep-alive (local dev / Playwright) ===
# Neon free tier autosuspends after ~5 min idle; a cold start stalls the first
# query by ~2-7s. A ping interval here keeps the compute warm while the dev
# server runs. Vercel production keeps it warm via the /api/health cron in
# vercel.json. Set to 0 to disable.
DATABASE_KEEPALIVE_MS="30000"

# === NextAuth (Auth.js v5) ===
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Required on Vercel / behind a proxy so Auth.js trusts the Host header.
AUTH_TRUST_HOST="true"

# === Seed admin password ===
# Used only by `npm run db:seed` when creating the admin@clickcart.com user.
# MUST be set to a strong value before seeding any production database.
ADMIN_SEED_PASSWORD="changeMeOnFirstRun_9f3K!"

# === Cron guard secret ===
# Bearer token for /api/cron/cancel-stale-pending (auto-cancels unpaid
# PENDING/CONFIRMED orders older than AUTO_CANCEL_PENDING_HOURS).
CRON_SECRET="generate-with-openssl-rand-base64-32"
AUTO_CANCEL_PENDING_HOURS="24"

# === Cloudinary (image uploads) ===
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# === Public URLs ===
# In production set these to the real domain (no trailing slash).
NEXT_PUBLIC_API_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# === Site contact / social (optional, env-overridable) ===
# NEXT_PUBLIC_SUPPORT_PHONE="+880 1712-345678"
# NEXT_PUBLIC_SUPPORT_EMAIL="support@clickcart.com.bd"
# NEXT_PUBLIC_SITE_ADDRESS="House 12, Road 5, Dhanmondi, Dhaka 1205, Bangladesh"
# NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com"
# NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com"
# NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com"

# === SSLCommerz (sandbox defaults: store_id=testbox, store_passwd=qwerty) ===
# Set SSLCOMMERZ_STORE_ID / SSLCOMMERZ_STORE_PASSWD to live values and
# SSLCOMMERZ_IS_LIVE=true for production payments.
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWD="qwerty"
SSLCOMMERZ_IS_LIVE="false"

# === Resend (transactional email) ===
# Emails log to the server console when RESEND_API_KEY is empty.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ClickCart <orders@clickcart.example>"

# === Google OAuth (optional) ===
# Auto-enables the Google sign-in provider when both are set. Register the
# callback URI <NEXT_PUBLIC_APP_URL>/api/auth/callback/google in Google Cloud.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""