# === Database (Neon PostgreSQL) ===
# Use the connection string WITHOUT the pooler (direct host) for Prisma transactions.
# Create a separate production database on Neon for deployment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/db?sslmode=require"

# === NextAuth (Auth.js v5) ===
# Generate with: openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Required on Vercel / behind a proxy so Auth.js trusts the Host header.
AUTH_TRUST_HOST="true"

# === Cloudinary (image uploads) ===
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# === Public URLs ===
# In production set these to the real domain (no trailing slash).
NEXT_PUBLIC_API_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# === SSLCommerz (sandbox defaults: store_id=testbox, store_passwd=qwerty) ===
# Set SSLCOMMERZ_STORE_ID / SSLCOMMERZ_STORE_PASSWD to live values and
# SSLCOMMERZ_IS_LIVE=true for production payments.
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASSWD="qwerty"
SSLCOMMERZ_IS_LIVE="false"

# === Resend (transactional email) ===
# Emails log to the server console when RESEND_API_KEY is empty.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ClickCart <orders@clickcart.example>"